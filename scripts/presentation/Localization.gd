static func get_text(key: String) -> String:
	if STRINGS.has(key):
		return str(STRINGS[key])
	return key


## Текст с подстановкой значений (как %-формат).
static func fmt(key: String, args: Array) -> String:
	var template: String = get_text(key)
	return template % args


static func property_name(property_key: String) -> String:
	return get_text("prop.%s.name" % property_key)


static func property_adjective(property_key: String) -> String:
	return get_text("prop.%s.adj" % property_key)


static func property_color(property_key: String) -> Color:
	match property_key:
		"warming":
			return Color(0.95, 0.5, 0.2)
		"invigorating":
			return Color(0.45, 0.8, 0.3)
		"calming":
			return Color(0.4, 0.65, 0.95)
		"hearty":
			return Color(0.88, 0.66, 0.28)
		"savoury":
			return Color(0.78, 0.62, 0.38)
		"earthy":
			return Color(0.62, 0.48, 0.3)
		"meaty":
			return Color(0.82, 0.38, 0.32)
		"sweet":
			return Color(0.8, 0.4, 0.62)
		"spicy":
			return Color(0.9, 0.3, 0.2)
		"magical":
			return Color(0.6, 0.55, 0.95)
	return Color(0.7, 0.6, 0.5)
